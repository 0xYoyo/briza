---
import { joinHref } from "../links";
import { OFFER_PHOTO } from "../photos";
import Button from "./Button.astro";
import Split from "./Split.astro";
---

<Split
  photo={OFFER_PHOTO}
  side="start"
  surface="sand-deep"
  align="bottom"
  ratio="4 / 5"
  shot="offer"
>
  <h2 class="offer__heading">
    <!--
      The numeral is the heading's own first word, set at display size — one
      statement, not a badge repeating the sentence beside it. The <bdi> is
      wrapped so its LTR run never drags the line's alignment with it.
    -->
    <span class="offer__numeral"><bdi>10%</bdi></span>
    <span class="offer__rest">הנחה על הקנייה הראשונה</span>
  </h2>
  <p class="offer__body">
    קבוצת הוואטסאפ של בריזה היא קבוצה שקטה — רק אירית כותבת בה, וכל סחורה חדשה מופיעה שם
    ראשונה. הצטרפו, ובקנייה הראשונה בחנות הראו בקופה שאתן בקבוצה ותקבלו <bdi>10%</bdi> הנחה.
  </p>
  <div class="offer__action">
    <Button kind="primary" href={joinHref()} icon="whatsapp">הצטרפו לקבוצת העדכונים</Button>
  </div>
</Split>

<style>
  .offer__heading {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-display);
    color: var(--text-body);
  }

  /* [rtl-numerals] an isolated LTR run; the display step above the 38–54 band */
  .offer__numeral {
    display: block;
    font-size: var(--text-numeral);
    line-height: 0.92;
    color: var(--text-accent);
  }

  .offer__rest {
    display: block;
    margin-block-start: var(--space-2);
    font-size: var(--text-h2);
  }

  .offer__body {
    max-inline-size: var(--measure-column);
    margin-block-start: var(--stack);
    font-size: var(--text-body-lg);
    line-height: var(--leading-body);
  }

  .offer__action {
    display: flex;
    margin-block-start: var(--stack-loose);
  }
</style>
