---
/**
 * Page section (DESIGN §2.1): vertical rhythm by padding only — no borders,
 * dividers or angled edges between sections. Content is a single column at
 * `--content-max` with the page gutters; headings align start.
 *
 * [one-viewport] a `locked` section is exactly `--section-lock` tall at
 * ≥900px with its content centred in that height and clipped to it, so the
 * section below can never peek in under it.
 */
type Props = {
  surface?: "page" | "sand" | "sand-deep" | "inverse";
  /** Section content runs to the viewport edge (the photo mosaic). */
  bleed?: boolean;
  /** One viewport tall at ≥900px, content centred. */
  locked?: boolean;
  /** Names the section in the DOM for screenshots and tests. */
  shot: string;
};

const { surface = "page", bleed = false, locked = false, shot } = Astro.props;
---

<section
  class:list={[
    "section",
    {
      "section--sand": surface === "sand",
      "section--sand-deep": surface === "sand-deep",
      "section--inverse": surface === "inverse",
      "section--bleed": bleed,
      "section--locked": locked,
    },
  ]}
  data-shot={shot}
  data-locked={locked ? "" : undefined}
>
  <div class="section__inner">
    <slot />
  </div>
  <slot name="bleed" />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
  }

  .section--sand {
    background: var(--surface-sand);
  }

  .section--sand-deep {
    background: var(--surface-sand-deep);
  }

  .section--inverse {
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
  }

  /* The mosaic runs to the viewport edge; only the heading keeps the gutter. */
  .section--bleed {
    padding-inline: 0;
  }
  .section--bleed .section__inner {
    /*
     * The heading sits on the grid rather than in the page's centred column:
     * it starts at the gutter, inside the first mosaic column, and the grid
     * runs from the same edge (DESIGN §2.7).
     */
    max-inline-size: none;
    margin-inline: 0;
    padding-inline: var(--gutter);
  }

  .section__inner {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    inline-size: 100%;
    max-inline-size: var(--content-max);
    margin-inline: auto;
    text-align: start;
  }

  /* Section headings: display face at h2, aligned start (DESIGN §2.3) */
  .section__inner :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-display);
    color: inherit;
  }

  @media (min-width: 900px) {
    .section {
      padding-block: var(--section-y-lg);
      padding-inline: var(--gutter-wide);
    }
    .section--bleed {
      padding-inline: 0;
    }
    .section--bleed .section__inner {
      padding-inline: var(--gutter-wide);
    }

    /* [one-viewport] one viewport, never less */
    .section--locked {
      min-block-size: var(--section-lock);
      justify-content: center;
      padding-block: var(--section-lock-pad);
    }
    .section--locked .section__inner {
      flex: 0 1 auto;
      min-block-size: 0;
    }
  }

  /*
   * [one-viewport] and never more, on any screen tall enough to hold the
   * content. On a shorter window the section flows rather than clipping its
   * own heading.
   */
  @media (min-width: 900px) and (min-height: 640px) {
    .section--locked {
      block-size: var(--section-lock);
      overflow: hidden;
    }
  }
</style>
