---
/**
 * Page section (DESIGN §2.1): vertical rhythm by padding only — no borders,
 * dividers or angled edges between sections. Content is a single column at
 * `--content-max` with the page gutters; headings align start.
 */
type Props = {
  surface?: "page" | "sand" | "inverse";
  /** Section content runs to the viewport edge (the photo mosaic). */
  bleed?: boolean;
  /** Names the section in the DOM for screenshots and tests. */
  shot: string;
};

const { surface = "page", bleed = false, shot } = Astro.props;
---

<section
  class:list={[
    "section",
    {
      "section--sand": surface === "sand",
      "section--inverse": surface === "inverse",
      "section--bleed": bleed,
    },
  ]}
  data-shot={shot}
>
  <div class="section__inner">
    <slot />
  </div>
  <slot name="bleed" />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
  }

  .section--sand {
    background: var(--surface-sand);
  }

  .section--inverse {
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
  }

  /* The mosaic runs to the viewport edge; only the heading keeps the gutter. */
  .section--bleed {
    padding-inline: 0;
  }
  .section--bleed .section__inner {
    padding-inline: var(--gutter);
  }

  .section__inner {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    inline-size: 100%;
    max-inline-size: var(--content-max);
    margin-inline: auto;
    text-align: start;
  }

  /* Section headings: display face at h2, aligned start (DESIGN §2.3) */
  .section__inner :global(h2) {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-display);
    color: inherit;
  }

  @media (min-width: 900px) {
    .section {
      padding-block: var(--section-y-lg);
      padding-inline: var(--gutter-wide);
    }
    .section--bleed {
      padding-inline: 0;
    }
    .section--bleed .section__inner {
      padding-inline: var(--gutter-wide);
    }
  }
</style>
