---
import { Image } from "astro:assets";
import type { Photo } from "../photos";
import Section from "./Section.astro";

type Props = {
  photos: readonly Photo[];
};

const { photos } = Astro.props;

// Tile width: 2 columns inside the page gutters below 900px, 3 columns inside
// the --content-max column at ≥900px (gap --space-3 = 12px).
const SIZES =
  "(min-width: 900px) calc((min(100vw - 80px, 1100px) - 24px) / 3), calc((100vw - 52px) / 2)";
---

{
  // [empty-collapses] an empty list renders nothing — no heading, no wrapper.
  photos.length > 0 && (
    <Section>
      <h2>מהמדפים שלנו</h2>
      <ul class="grid">
        {photos.map((photo) => (
          <li>
            <Image
              class="grid__img"
              src={photo.src}
              alt={photo.alt}
              widths={[400, 600, 800]}
              sizes={SIZES}
              width={800}
              format="webp"
              loading="lazy"
              decoding="async"
            />
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  /*
   * Photos grid (DESIGN §2.7): 2 columns <900px, 3 at ≥900px, 4:5 tiles,
   * --radius-md, gap --space-3. [not-catalog] no caption, link, hover state
   * or overlay per photo. [loading-state] --surface-raised placeholder at
   * the final aspect ratio while lazy images arrive.
   */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    margin-block: var(--stack) 0;
    padding: 0;
    list-style: none;
  }

  .grid__img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-md);
    background: var(--surface-raised);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
