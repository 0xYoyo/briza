---
import { Image } from "astro:assets";
import type { Photo } from "../photos";
import Section from "./Section.astro";

type Props = {
  photos: readonly Photo[];
};

const { photos } = Astro.props;

// Full-bleed: three columns of the viewport at ≥900px, two below it.
const SIZES = "(min-width: 900px) 34vw, 51vw";
---

{
  // [empty-collapses] an empty list renders nothing — no heading, no wrapper.
  photos.length > 0 && (
    <Section shot="photos" surface="sand" bleed>
      <h2>מהמדפים שלנו</h2>
      <ul class="mosaic" slot="bleed">
        {photos.map((photo, i) => (
          <li class={`mosaic__cell mosaic__cell--${i + 1}`}>
            <Image
              class="mosaic__img"
              src={photo.src}
              alt={photo.alt}
              widths={[360, 560, 760]}
              sizes={SIZES}
              format="webp"
              quality={70}
              loading="lazy"
              decoding="async"
              style={`object-position: ${photo.position ?? "50% 50%"}`}
            />
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  /*
   * A mosaic, not a spreadsheet: every cell is one upright 4:5 frame on an
   * even seam, and two of them run two rows tall at fixed positions, so the
   * wall has a rhythm without any cell being a different shape from the rest.
   * Row height comes from the cell's own aspect ratio, so nothing reflows on
   * load ([no-layout-shift]). Full-bleed with --mosaic-gap seams;
   * [not-catalog] no caption, link, hover state or overlay per photo.
   * Cells are placed by hand at both breakpoints — auto-placement leaves a
   * hole once a frame spans two rows.
   */
  .mosaic {
    display: grid;
    /* 2 columns x 3 rows on phones; the container's aspect ratio sets the row
       height, so every cell is sized from the viewport width alone and
       nothing reflows on load ([no-layout-shift]) */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, minmax(0, 1fr));
    aspect-ratio: 8 / 15;
    /* the section is a flex column: opt out of the content-based minimum so
       `aspect-ratio` alone sets the row height */
    min-block-size: 0;
    gap: var(--mosaic-gap);
    margin-block: var(--space-10) 0;
    padding: 0;
    list-style: none;
  }

  .mosaic__cell {
    min-block-size: 0;
    overflow: hidden;
    background: var(--surface-raised);
  }

  /*
   * Phones: the two tall frames hold opposite columns, offset by a row, so no
   * seam runs straight across the wall.
   */
  .mosaic__cell--1 {
    grid-row: 1 / span 2;
    grid-column: 1;
  }
  .mosaic__cell--2 {
    grid-row: 2 / span 2;
    grid-column: 2;
  }
  .mosaic__cell--3 {
    grid-row: 3;
    grid-column: 1;
  }
  .mosaic__cell--4 {
    grid-row: 1;
    grid-column: 2;
  }

  .mosaic__img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    /*
     * 3 columns x 2 rows: two two-row frames hold the outer columns and the
     * two single frames stack in the middle one.
     */
    .mosaic {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(0, 1fr));
      aspect-ratio: 6 / 5;
      margin-block-start: var(--space-12);
    }
    /* the two tall frames hold the outer columns, the two single frames
       stack between them */
    .mosaic__cell--1 {
      grid-row: 1 / span 2;
      grid-column: 1;
    }
    .mosaic__cell--2 {
      grid-row: 1 / span 2;
      grid-column: 3;
    }
    .mosaic__cell--3 {
      grid-row: 1;
      grid-column: 2;
    }
    .mosaic__cell--4 {
      grid-row: 2;
      grid-column: 2;
    }
  }
</style>
