---
/**
 * Split panel — the page's structural unit (DESIGN §2.1): one half is a
 * full-bleed photograph running to the viewport edge, the other half is a
 * real reading column at `--measure-column`, vertically centred. Panels
 * alternate the photograph from side to side down the page. Below 900px the
 * panel stacks: photograph over text, the photograph still edge to edge.
 *
 * [one-viewport] at ≥900px the panel is exactly `--section-lock` tall: the
 * photograph is clipped to that height by `object-fit: cover` inside an
 * `overflow: hidden` column, so no frame runs past the panel's lower edge and
 * the neighbouring section's ground never continues beside it at half width.
 */
import { Image } from "astro:assets";
import type { Photo } from "../photos";

type Props = {
  photo: Photo;
  /** Which side the photograph takes at ≥900px. Panels alternate. */
  side?: "start" | "end";
  surface?: "page" | "sand" | "sand-deep";
  /**
   * `bottom` anchors the column to the panel's lower edge — the form a panel
   * carrying a join pill takes, so [one-cta] holds inside one viewport.
   */
  align?: "center" | "bottom";
  /** Aspect ratio of the stacked photograph below 900px. */
  ratio?: string;
  /** Names the section in the DOM for screenshots and tests. */
  shot: string;
};

const {
  photo,
  side = "start",
  surface = "page",
  align = "center",
  ratio = "1 / 1",
  shot,
} = Astro.props;

// One half of the viewport at ≥900px, the full width below it.
const SIZES = "(min-width: 900px) 50vw, 100vw";
---

<section
  class:list={[
    "panel",
    `panel--${side}`,
    `panel--${align}`,
    {
      "panel--sand": surface === "sand",
      "panel--sand-deep": surface === "sand-deep",
    },
  ]}
  data-shot={shot}
  data-locked
  style={`--split-ratio: ${ratio}; --split-position: ${photo.position ?? "50% 50%"};`}
>
  <div class="panel__photo">
    <Image
      src={photo.src}
      alt={photo.alt}
      widths={[440, 720, 1000, 1400]}
      sizes={SIZES}
      format="webp"
      quality={72}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="panel__text">
    <div class="panel__column" data-reveal>
      <slot />
    </div>
  </div>
</section>

<style>
  .panel {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface-page);
    /* the photograph is clipped to the panel, never bled into its neighbour */
    overflow: hidden;
  }

  .panel--sand {
    background: var(--surface-sand);
  }

  .panel--sand-deep {
    background: var(--surface-sand-deep);
  }

  .panel__photo {
    position: relative;
    aspect-ratio: var(--split-ratio);
    overflow: hidden;
    background: var(--surface-raised);
  }

  .panel__photo :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--split-position);
  }

  .panel__text {
    display: flex;
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
  }

  .panel__column {
    inline-size: 100%;
    max-inline-size: var(--measure-column);
  }

  @media (min-width: 900px) {
    /*
     * [one-viewport] one viewport, never less: a shorter panel would leave
     * the neighbouring section's ground beside a full-height photograph.
     */
    .panel {
      grid-template-rows: 1fr;
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
      min-block-size: var(--section-lock);
    }

    /* The alternating half. `order` is direction-agnostic ([logical-props]). */
    .panel--end .panel__photo {
      order: 2;
    }

    .panel__photo {
      aspect-ratio: auto;
      block-size: 100%;
      min-block-size: 0;
    }

    .panel__text {
      align-items: center;
      /* the pane's own padding can never sum past the locked height */
      padding-block: var(--section-lock-pad);
      padding-inline: var(--pane-pad);
      min-block-size: 0;
      overflow: hidden;
    }

    /*
     * A poster column: heading, sentence and pill read as one block held at
     * the panel's lower edge, with the sand field open above them. The pill's
     * inset from that edge is what [one-cta] is measured against.
     */
    .panel--bottom .panel__text {
      align-items: flex-end;
      padding-block-end: var(--panel-cta-inset);
    }
  }

  /*
   * [one-viewport] and never more, on any screen tall enough to hold the
   * column: `block-size` fixes the panel in both directions so the section
   * below can never peek in under it. On a window shorter than the content
   * the panel flows instead — a clipped heading is worse than a long page.
   */
  @media (min-width: 900px) and (min-height: 640px) {
    .panel {
      block-size: var(--section-lock);
    }
  }
</style>
