---
import { HOURS, MAPS_URL } from "../constants";
import { hoursRows } from "../hours";
import { callHref, joinHref } from "../links";
import { VISIT_PHOTO } from "../photos";
import Address from "./Address.astro";
import Button from "./Button.astro";
import Split from "./Split.astro";

const rows = hoursRows(HOURS);
---

<Split photo={VISIT_PHOTO} side="start" surface="sand" ratio="1 / 1" shot="visit">
  <h2 class="visit__heading">גן העיר, קומת כניסה</h2>
  <p class="visit__address"><Address /></p>
  <div class="visit__hours">
    <p class="visit__status" data-status hidden></p>
    <table class="hours">
      <thead>
        <tr>
          <th scope="col">יום</th>
          <th scope="col">שעות</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <td>{row.days}</td>
              <td>
                <bdi>{row.time}</bdi>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <div class="visit__actions">
    <Button kind="secondary" href={MAPS_URL} target="_blank" rel="noopener">נווטו לחנות</Button>
    <Button kind="secondary" href={callHref()} icon="phone">התקשרו</Button>
    <Button kind="primary" href={joinHref()} icon="whatsapp">הצטרפו לקבוצת העדכונים</Button>
  </div>
</Split>

<style>
  .visit__heading {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
    letter-spacing: var(--track-display);
    color: var(--text-body);
  }

  .visit__address {
    margin-block-start: var(--stack-tight);
    color: var(--text-muted);
  }

  /*
   * The address→table gap is constant. The status line is overlaid inside
   * that gap (absolute, margin 0), so the table sits at the same position
   * with or without JavaScript ([no-js-state]).
   */
  .visit__hours {
    position: relative;
    margin-block-start: var(--stack-loose);
  }

  .visit__status {
    position: absolute;
    inset-block-end: 100%;
    inset-inline-start: 0;
    margin: 0;
    padding-block-end: var(--space-1);
    line-height: var(--leading-snug);
    color: var(--text-accent);
  }

  /* Hours table (DESIGN §2.7): raised surface, --radius-lg, hairline rows */
  .hours {
    inline-size: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: var(--surface-raised);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hours th,
  .hours td {
    padding-block: var(--space-3);
    padding-inline: var(--space-4);
    text-align: start;
  }

  .hours th {
    font-size: var(--text-h3);
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    border-block-end: var(--border-2) solid var(--wood-500);
  }

  .hours tbody tr + tr td {
    border-block-start: var(--border-1) solid var(--border-hairline);
  }

  .hours td:last-child {
    color: var(--text-muted);
  }

  .visit__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--stack-tight);
    margin-block-start: var(--stack-loose);
  }

  @media (min-width: 600px) {
    /*
     * The three actions sit on one line where they fit and wrap the join pill
     * onto its own line where they do not — it is never crowded by a second
     * action of the same weight.
     */
    .visit__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3);
    }
    .visit__actions :global(.btn) {
      min-inline-size: 0;
    }
  }
</style>
