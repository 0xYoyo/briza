---
import {
  FACEBOOK_URL,
  INSTAGRAM_URL,
  PHONE_DISPLAY,
  STORE_NAME,
  TIKTOK_URL,
} from "../constants";
import { callHref } from "../links";
import Address from "./Address.astro";

type Social = { href: string; label: string; path: string };

// [empty-collapses] each icon renders only when its URL is non-empty;
// when all are empty the whole row is omitted.
const socials: Social[] = (
  [
    {
      href: TIKTOK_URL,
      label: "בריזה בטיקטוק",
      path: "M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z",
    },
    {
      href: INSTAGRAM_URL,
      label: "בריזה באינסטגרם",
      path: "M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0m0 5.84A6.16 6.16 0 1 0 12 18.16 6.16 6.16 0 0 0 12 5.84M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88",
    },
    {
      href: FACEBOOK_URL,
      label: "בריזה בפייסבוק",
      path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
    },
  ] satisfies Social[]
).filter((s) => s.href !== "");
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__name">{STORE_NAME}</p>
    <p class="footer__meta"><Address /></p>
    <p class="footer__meta">
      <a class="footer__phone" href={callHref()}><bdi>{PHONE_DISPLAY}</bdi></a>
    </p>
    {
      socials.length > 0 && (
        <ul class="footer__social">
          {socials.map((s) => (
            <li>
              <a href={s.href} aria-label={s.label} rel="noopener" target="_blank">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                  <path fill="currentColor" d={s.path} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</footer>

<style>
  /* Navy bookend (DESIGN §2.1); [hebrew-only] no Latin visible text */
  .footer {
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
    padding-block: var(--section-y);
    padding-inline: var(--gutter);
  }

  .footer__inner {
    max-inline-size: var(--content-max);
    margin-inline: auto;
  }

  /* Name in the display face at h3, without glow */
  .footer__name {
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-h3);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-display);
  }

  .footer__meta {
    margin-block-start: var(--stack-tight);
    color: var(--text-on-inverse-muted);
  }

  /* [rtl-numerals] the phone is an isolated LTR run via <bdi> */
  .footer__phone {
    color: var(--text-on-inverse);
  }

  .footer__social {
    display: flex;
    gap: var(--space-3);
    margin-block: var(--stack) 0;
    padding: 0;
    list-style: none;
  }

  /* [tap-56] 56×56 hit area, 28px glyph, ice on navy */
  .footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: var(--tap-min);
    block-size: var(--tap-min);
    border-radius: var(--radius-pill);
    color: var(--text-on-inverse);
    transition: color var(--dur-base) var(--ease-out);
  }
  .footer__social a:hover {
    color: var(--text-on-inverse-muted);
  }
  .footer__social svg {
    inline-size: 28px;
    block-size: 28px;
  }

  @media (min-width: 900px) {
    .footer {
      padding-block: var(--section-y-lg);
      padding-inline: var(--gutter-wide);
    }
  }
</style>
