---
/**
 * Pill action link (DESIGN §2.7). Three kinds only: primary (green surface,
 * navy text, 64px), secondary (navy surface, ice text, 56px), quiet
 * (transparent, 2px navy border; ice on inverse surfaces).
 * [no-dead-button] `href` is required and comes from src/links.ts.
 */
type Props = {
  href: string;
  kind?: "primary" | "secondary" | "quiet";
  /** Optional 24px glyph rendered inline before the label. */
  icon?: "whatsapp" | "phone";
  /** Quiet buttons on navy surfaces switch to ice border/text. */
  inverse?: boolean;
  /** For external destinations (maps, socials): open in a new tab. */
  target?: "_blank";
  rel?: string;
};

const {
  href,
  kind = "primary",
  icon,
  inverse = false,
  target,
  rel,
} = Astro.props;
---

<a
  class:list={["btn", `btn--${kind}`, { "btn--inverse": inverse }]}
  href={href}
  target={target}
  rel={rel}
>
  {
    icon === "whatsapp" && (
      <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
        />
      </svg>
    )
  }
  {
    icon === "phone" && (
      <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          fill="currentColor"
          d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.12.37 2.33.57 3.58.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1.02l-2.2 2.2Z"
        />
      </svg>
    )
  }
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    inline-size: 100%;
    min-block-size: var(--tap-min);
    padding-block: var(--space-4);
    padding-inline: var(--space-8);
    border: 0;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-weight: var(--weight-semibold);
    font-size: var(--text-label);
    line-height: 1;
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  /* Press: 120ms scale only, no lift (DESIGN §2.6) */
  .btn:active {
    transform: scale(var(--press-scale));
  }

  /* [focus-visible] */
  .btn:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 2px;
  }

  /* [green-is-join] the only element on the page using WhatsApp green */
  .btn--primary {
    min-block-size: var(--tap-lg);
    background: var(--action-primary);
    color: var(--action-primary-text);
  }
  .btn--primary:hover {
    background: var(--action-primary-hover);
  }

  .btn--secondary {
    background: var(--action-secondary);
    color: var(--action-secondary-text);
  }
  .btn--secondary:hover {
    background: var(--action-secondary-hover);
  }

  .btn--quiet {
    background: transparent;
    border: var(--border-2) solid var(--action-quiet-border);
    padding-block: calc(var(--space-4) - var(--border-2));
    color: var(--action-quiet-text);
  }
  .btn--quiet:hover {
    background: var(--surface-raised);
  }
  .btn--quiet.btn--inverse {
    border-color: var(--ice-100);
    color: var(--ice-100);
  }
  .btn--quiet.btn--inverse:hover {
    background: var(--navy-800);
  }

  @media (min-width: 600px) {
    .btn {
      inline-size: auto;
      min-inline-size: 200px;
    }
  }

  .btn__icon {
    flex: none;
    inline-size: 24px;
    block-size: 24px;
  }
</style>
