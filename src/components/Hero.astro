---
import { Image } from "astro:assets";
import { STORE_NAME } from "../constants";
import { joinHref } from "../links";
import { HERO_PHOTO } from "../photos";
import Button from "./Button.astro";
---

<section class="hero" data-shot="hero">
  <div class="hero__frame">
    <Image
      class="hero__photo"
      src={HERO_PHOTO.src}
      alt={HERO_PHOTO.alt}
      widths={[540, 900, 1400, 1800]}
      sizes="100vw"
      format="webp"
      quality={74}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero__panel">
    <div class="hero__content">
      <!--
        [wordmark-is-photo] the lit sign in the photograph is the wordmark.
        The name still exists as live text for assistive technology and for
        search engines — it is simply never painted twice.
      -->
      <h1 class="sr-only">{STORE_NAME}</h1>
      <p class="hero__eyebrow">גן העיר, תל אביב</p>
      <p class="hero__line">בגדי נשים מיובאים, נבחרים ביד. ואירית שעונה לכן באהבה.</p>
      <div class="hero__action">
        <Button kind="primary" href={joinHref()} icon="whatsapp">הצטרפו לקבוצת העדכונים</Button>
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * [loading-state] navy ground so the panel reads before the photo arrives.
   * Below 900px the photograph takes every pixel the content block does not
   * need, so the sign always survives the crop on a narrow frame; at ≥900px
   * the photograph is the whole viewport and the content sits over the
   * scrim, bottom-start.
   */
  .hero {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    /*
     * The whole hero composition — sign, line, pill — must be visible above
     * the sticky bar, so the bar's reserved height comes out of the first
     * screen rather than sitting on top of the join button.
     */
    min-block-size: calc(
      100svh - var(--sticky-bar-height) - env(safe-area-inset-bottom, 0px)
    );
    background: var(--surface-inverse);
    color: var(--text-on-inverse);
  }

  .hero__frame {
    position: relative;
    min-block-size: 0;
    overflow: hidden;
  }

  .hero__photo {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    /* keep the sign band, top ~15% of the frame, inside every crop */
    object-position: 50% 0%;
  }

  /*
   * [contrast-aa] the scrim covers the lower third only and lands on the
   * navy panel, so photograph and panel read as one dark field.
   */
  .hero__frame::after {
    content: "";
    position: absolute;
    inset-block-start: 62%;
    inset-block-end: 0;
    inset-inline: 0;
    background: var(--scrim-hero);
  }

  .hero__panel {
    position: relative;
  }

  .hero__content {
    inline-size: 100%;
    max-inline-size: var(--content-max);
    margin-inline: auto;
    padding-block: var(--space-6) var(--space-10);
    padding-inline: var(--gutter);
    text-align: start;
  }

  .hero__eyebrow {
    font-weight: var(--weight-semibold);
    font-size: var(--text-label);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-label);
    color: var(--text-on-inverse-muted);
  }

  .hero__line {
    max-inline-size: 26ch;
    margin-block-start: var(--stack-tight);
    font-family: var(--font-display);
    font-weight: var(--weight-regular);
    font-size: var(--text-hero-line);
    line-height: var(--leading-snug);
    letter-spacing: var(--track-display);
    color: var(--text-on-inverse);
  }

  .hero__action {
    display: flex;
    margin-block-start: var(--stack-loose);
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-rows: 1fr;
      block-size: 100svh;
      min-block-size: 100svh;
    }

    /* photograph and panel share one cell; the panel hangs at the bottom */
    .hero__frame,
    .hero__panel {
      grid-area: 1 / 1;
    }

    .hero__panel {
      align-self: end;
    }

    .hero__frame::after {
      inset-block-start: 46%;
    }

    /*
     * [one-cta] the hero and the Offer are one viewport each, so the only
     * thing keeping their two green pills off one screen is where each sits
     * inside its own section: the hero's pill clears the hero's lower edge by
     * --hero-cta-inset, which is the Offer pill's own inset plus its height.
     */
    .hero__content {
      padding-block-end: var(--hero-cta-inset);
      padding-inline: var(--gutter-wide);
    }

    .hero__line {
      max-inline-size: 22ch;
    }
  }
</style>
