{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/site/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Secular One|Assistant|Frank Ruhl Libre))/i]",
        "message": "Font not provided by the design system. Available: Secular One, Assistant, Frank Ruhl Libre."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, icon, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sand|navy|ice|coral|outline)$/]",
        "message": "<Badge> tone must be one of 'sand' | 'navy' | 'ice' | 'coral' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|href|fullWidth|disabled|iconOnly|label|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, icon, href, fullWidth, disabled, iconOnly, label, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:whatsapp|dark|outline|ghostOnDark)$/]",
        "message": "<Button> variant must be one of 'whatsapp' | 'dark' | 'outline' | 'ghostOnDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md)$/]",
        "message": "<Button> size must be one of 'lg' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|interactive|padding|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, interactive, padding, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Card> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HoursRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:day|hours|closed|key|ref|className|style|children)$/]",
        "message": "<HoursRow> doesn't accept that prop. Declared props: day, hours, closed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|base|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, base, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|value|href|tone|style|key|ref|className|style|children)$/]",
        "message": "<InfoRow> doesn't accept that prop. Declared props: icon, label, value, href, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InfoRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<InfoRow> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Photo'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|key|ref|className|style|children)$/]",
        "message": "<Photo> doesn't accept that prop. Declared props: src, alt."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhotoHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|alt|tagline|children|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<PhotoHero> doesn't accept that prop. Declared props: image, alt, tagline, children, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lead|align|tone|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lead, align, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<SectionHeading> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SectionHeading> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:network|href|label|key|ref|className|style|children)$/]",
        "message": "<SocialLink> doesn't accept that prop. Declared props: network, href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:whatsappHref|telHref|label|visible|revealAfter|style|key|ref|className|style|children)$/]",
        "message": "<WhatsAppBar> doesn't accept that prop. Declared props: whatsappHref, telHref, label, visible, revealAfter, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WhatsAppBar'] > JSXAttribute[name.name='revealAfter'] > Literal[value!=/^(?:hero|always)$/]",
        "message": "<WhatsAppBar> revealAfter must be one of 'hero' | 'always'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|glow|tone|as|style|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: size, glow, tone, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|hero)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg' | 'hero'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Wordmark> tone must be one of 'light' | 'dark'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
